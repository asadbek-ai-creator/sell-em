generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String    @id @default(uuid())
  name      String
  products  Product[]
  users     User[]
}

model User {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  role      String   @default("SELLER") 
  totalXp   Int      @default(0)
  streak    Int      @default(0)
}

model Product {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String   
  brand       String   
  sizeRange   String   
  imageUrl    String?  
  aiPitchData Json?    
  createdAt   DateTime @default(now())
}

model DailyTask {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime @default(now())
  productIds String[] 
  isTested   Boolean  @default(false) 
}
